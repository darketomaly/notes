<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Notes Canvas</title>
		<style>
			:root {
				color-scheme: dark;
			}

			* {
				box-sizing: border-box;
			}

			html,
			body {
				height: 100%;
				margin: 0;
				font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
				background: #151515;
				color: #ececec;
			}

			.canvas {
				position: relative;
				height: 100%;
				width: 100%;
				overflow: hidden;
				background:
					radial-gradient(circle at 1px 1px, #2a2a2a 1px, transparent 0) 0 0 / 24px 24px,
					#171717;
			}

			.hint {
				position: absolute;
				top: 1rem;
				left: 1rem;
				margin: 0;
				padding: 0.4rem 0.6rem;
				background: rgba(0, 0, 0, 0.35);
				border: 1px solid #2f2f2f;
				border-radius: 0.5rem;
				font-size: 0.85rem;
				letter-spacing: 0.01em;
				user-select: none;
				pointer-events: none;
			}

			.note {
				position: absolute;
				width: 240px;
				padding: 0.55rem 0.65rem;
				border: 1px solid #484848;
				border-radius: 0.65rem;
				background: #222;
				box-shadow: 0 8px 20px rgba(0, 0, 0, 0.28);
			}

			.note input {
				width: 100%;
				border: 0;
				outline: 0;
				padding: 0;
				font: inherit;
				background: transparent;
				color: #f5f5f5;
			}

			.note input::placeholder {
				color: #8b8b8b;
			}
		</style>
	</head>
	<body>
		<main class="canvas" id="canvas" aria-label="Notes canvas">
			<p class="hint">Double-click anywhere to create a note</p>
		</main>
		<script>
			const NOTE_WIDTH = 240;
			const EDGE_PADDING = 12;
			const canvas = document.getElementById("canvas");

			if (canvas) {
				canvas.addEventListener("dblclick", (event) => {
					const target = event.target;
					if (target instanceof HTMLElement && target.closest(".note")) {
						return;
					}

					const bounds = canvas.getBoundingClientRect();
					const maxLeft = bounds.width - NOTE_WIDTH - EDGE_PADDING;
					const left = Math.min(
						Math.max(event.clientX - bounds.left, EDGE_PADDING),
						maxLeft,
					);
					const top = Math.max(event.clientY - bounds.top, EDGE_PADDING);

					const note = document.createElement("div");
					note.className = "note";
					note.style.left = `${left}px`;
					note.style.top = `${top}px`;

					const input = document.createElement("input");
					input.type = "text";
					input.placeholder = "Write a note…";
					input.setAttribute("aria-label", "Note content");

					note.appendChild(input);
					canvas.appendChild(note);
					input.focus();
				});
			}
		</script>
	</body>
</html>
